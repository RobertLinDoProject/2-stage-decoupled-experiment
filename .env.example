APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

LOCAL_ARTIFACT_ROOT=/app/storage

# Host paths used by Docker Compose volume mounts.
CURRENT_PROJECT_DATA_ROOT=./Data
CURRENT_PROJECT_CONFIG_ROOT=./configs

LIVE_GAI_PROVIDER_ENABLED=true
GAI_EXECUTION_MODE=live
GAI_PROVIDER_NAME=ollama
GAI_PROVIDER_MODEL=mistral:7b-instruct-v0.3-q4_K_M
GAI_PROVIDER_ENDPOINT=http://host.docker.internal:11434/api/chat
GAI_PROVIDER_API_KEY=
# Set this to the exact Ollama /api/tags digest for the installed model.
GAI_PROVIDER_MODEL_VERSION=
GAI_PROMPT_TEMPLATE_VERSION=m6_ollama_action_v1
GAI_TEMPERATURE=
GAI_REASONING_EFFORT=
GAI_TIMEOUT_MS=120000
GAI_MAX_RETRIES=1
GAI_BUDGET_MODE=auto
GAI_BUDGET_MAX_REQUESTS_PER_RUN=4
GAI_BUDGET_HARD_LIMIT=50000
GAI_MAX_OUTPUT_TOKENS=1024
GAI_NUM_CTX=2048
GAI_KEEP_ALIVE=5m
GAI_SEED=114

# Optional hosted M6 provider. Keep the key server-side; never expose it to frontend.
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5-nano-2025-08-07
